  ==============================================
  pipeline {
    agent any

    tools {
        jdk 'java'
        nodejs 'node23'
    }

    environment {
        IMAGE_NAME = "react-node-app"
        CONTAINER_NAME = "react-node-app"
        APP_PORT = "3000"
    }

    stages {

        stage("Checkout") {
            steps {
                git branch: 'master',
                    url: 'https://github.com/vivekics/DevOps-Project-Zomato-Kastro.git'
            }
        }

        stage("Build Docker Image") {
            steps {
                script {
                    sh "docker build -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage("Deploy Container") {
            steps {
                script {
                    // Stop and remove old container if it exists
                    sh """
                        docker stop ${CONTAINER_NAME} || true
                        docker rm ${CONTAINER_NAME} || true
                    """

                    // Run new container on port 3000
                    sh """
                        docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:${APP_PORT} \
                        ${IMAGE_NAME}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Application deployed successfully on port 3000"
        }
        failure {
            echo "Deployment failed"
        }
    }
}
